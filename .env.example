# HTTP
PORT=3000

# PostgreSQL
POSTGRES_DB=wagering-finances
POSTGRES_USER=wagering_app
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# LocalStack (get a token from https://app.localstack.cloud/)
LOCALSTACK_AUTH_TOKEN=replace-with-your-localstack-auth-token
LOCALSTACK_PORT=4566

# Dedicated database for PostgreSQL integration tests (never point this to the development database)
POSTGRES_TEST_DATABASE_URL=postgresql://wagering_app:mysecretpassword@localhost:5432/wagering_finances_test