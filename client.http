@baseUrl = http://localhost:3000

### Create a wallet with an initial balance
# @name createWallet
POST {{baseUrl}}/wallets
Content-Type: application/json

{
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "initialBalance": {
    "amount": "1000.00",
    "currency": "BRL"
  }
}

### Get wallet by ID
GET {{baseUrl}}/wallets/{{createWallet.response.body.$.id}}
Accept: application/json

### Get wallet ledger
GET {{baseUrl}}/wallets/{{createWallet.response.body.$.id}}/ledger?limit=50
Accept: application/json

### Submit a BET
# @name submitBet
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: provider-a:transaction-123
Content-Type: application/json

{
  "providerId": "provider-a",
  "externalTransactionId": "transaction-123",
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "BET",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Submit a WIN for the processed BET above
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: provider-a:win-123
Content-Type: application/json

{
  "providerId": "provider-a",
  "externalTransactionId": "win-123",
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "WIN",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "50.00",
    "currency": "BRL"
  }
}

### Submit a LOSS
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: provider-a:loss-123
Content-Type: application/json

{
  "providerId": "provider-a",
  "externalTransactionId": "loss-123",
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-988",
  "gameId": "fortune-chimp",
  "kind": "LOSS",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Refund the BET (send independently; only once per processed BET)
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: provider-a:refund-transaction-123
Content-Type: application/json

{
  "providerId": "provider-a",
  "externalTransactionId": "refund-transaction-123",
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "REFUND",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Roll back a processed transaction (send independently; one processed rollback per reference)
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: provider-a:rollback-transaction-123
Content-Type: application/json

{
  "providerId": "provider-a",
  "externalTransactionId": "rollback-transaction-123",
  "playerId": "d0c4be2c-e53d-44df-9724-e0d5d5172d0b",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "ROLLBACK",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}