@baseUrl = http://localhost:3000
@providerId = provider-a

### Create a wallet with an initial balance
# Use a new playerId if you want to create another wallet for the same currency.
# @name createWallet
POST {{baseUrl}}/wallets
Content-Type: application/json

{
  "playerId": "15e304a7-bb8d-4cd2-a09e-98f87edf81a3",
  "initialBalance": {
    "amount": "1000.00",
    "currency": "BRL"
  }
}

### Get wallet by ID
GET {{baseUrl}}/wallets/{{createWallet.response.body.$.id}}
Accept: application/json

### Get wallet ledger
GET {{baseUrl}}/wallets/{{createWallet.response.body.$.id}}/ledger?limit=50
Accept: application/json

### Reconcile wallet balance with the ledger
POST {{baseUrl}}/wallets/{{createWallet.response.body.$.id}}/reconciliation
Accept: application/json

### Submit a BET
# The API returns 202 while the command is queued. Poll the transaction endpoint for its final status.
# @name submitBet
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: {{providerId}}:transaction-123
Content-Type: application/json

{
  "providerId": "{{providerId}}",
  "externalTransactionId": "transaction-123",
  "playerId": "{{createWallet.response.body.$.playerId}}",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "BET",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Check the BET status and resulting balance
# A confirmed unsent command becomes FAILED; uncertain delivery stays PENDING for reconciliation.
GET {{baseUrl}}/wagering/transactions/{{submitBet.response.body.$.transactionId}}
Accept: application/json

### Submit a WIN for the BET above
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: {{providerId}}:win-123
Content-Type: application/json

{
  "providerId": "{{providerId}}",
  "externalTransactionId": "win-123",
  "playerId": "{{createWallet.response.body.$.playerId}}",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "WIN",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "50.00",
    "currency": "BRL"
  }
}

### Submit a LOSS
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: {{providerId}}:loss-123
Content-Type: application/json

{
  "providerId": "{{providerId}}",
  "externalTransactionId": "loss-123",
  "playerId": "{{createWallet.response.body.$.playerId}}",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-988",
  "gameId": "fortune-chimp",
  "kind": "LOSS",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Refund the BET (send independently; only once per processed BET)
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: {{providerId}}:refund-transaction-123
Content-Type: application/json

{
  "providerId": "{{providerId}}",
  "externalTransactionId": "refund-transaction-123",
  "playerId": "{{createWallet.response.body.$.playerId}}",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "REFUND",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Roll back a processed transaction (send independently; one processed rollback per reference)
POST {{baseUrl}}/wagering/transactions
Idempotency-Key: {{providerId}}:rollback-transaction-123
Content-Type: application/json

{
  "providerId": "{{providerId}}",
  "externalTransactionId": "rollback-transaction-123",
  "playerId": "{{createWallet.response.body.$.playerId}}",
  "walletId": "{{createWallet.response.body.$.id}}",
  "roundId": "round-987",
  "gameId": "fortune-chimp",
  "kind": "ROLLBACK",
  "referenceExternalTransactionId": "transaction-123",
  "money": {
    "amount": "25.00",
    "currency": "BRL"
  }
}

### Get transaction by internal ID
GET {{baseUrl}}/wagering/transactions/{{submitBet.response.body.$.transactionId}}
Accept: application/json

### Get transaction by provider and external ID
GET {{baseUrl}}/providers/{{providerId}}/wagering/transactions/transaction-123
Accept: application/json